@endpoint = http://localhost:3000/api/cars
@dummyEndpoint = http://localhost:3000

###
# @name getAllCars
GET  {{endpoint}} HTTP/3.0
content-type: application/json
x-api-key: blablabla


### creating a car: working
# @name postACar
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blablabla

{   
    "make": "Toyota",
    "model": "2030"
}

###
@newCar = {{postACar.response.body._id}}

### creating a car: mongoDB validation, incomplete schema
# if you send a POST request with more fields or missing one of the two required fields
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blablabla

{   
    "make": "Toyota"
}


### creating a car: mongoDB validation, incomplete schema
# What happens if one of the required fields is an empty string “”. - same error as before
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blablabla

{   
    "make": "",
    "model": "2201"
}

### creating a car: App Exception, wrong json, trailing comma
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blablabla

{   
    "make": "Toyota",
}

### creating a car: mongoDB validation
# with a string rather than a number for the year. - it succeeds!
# if there is only a number
# so like js. if it can be casted to a number, it will cast
# if can't - keeps as string
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blablabla

{   
    "make": "Toyota",
    "model": "sdf",
    "year": "1951b"
}

### this will fail for zod. it doesn't cast string to number. strict
POST {{endpoint}} HTTP/1.1
content-type: application/json
x-api-key: blablabla

{   
    "make": "Toyota",
    "model": "sdf",
    "year": "1951"
}

###
GET {{endpoint}}/{{newCar}} HTTP/3.0
Content-Type: application/json

### get non existent car
GET  {{endpoint}}/sillycarID HTTP/3.0
content-type: application/json

### update a car 
# will give invalid input cause zod don't cast
PUT  {{endpoint}}/6ab42b6c7de6ac8ecb09eacf HTTP/3.0
content-type: application/json
x-api-key: blablabla

{"make": "UPDATED Ford123", "model": "Mustang GT", "year": "2341234"}

### delete a car
DELETE  {{endpoint}}/asdf HTTP/3.0
content-type: application/json

