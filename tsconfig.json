{
  "compilerOptions": {
    "target": "ES2022",

    // "type": "module" in package.json means NodeNext resolution, not "bundler"
    "module": "nodenext",
    "moduleResolution": "nodenext",

    // REQUIRED in TS 7: rootDir defaults to "./", which would emit build/src/app.js
    // and break the existing "start": "node build/app.js" script
    "rootDir": "./src",
    "outDir": "./build",

    // REQUIRED in TS 7: types defaults to [], so @types/node is NOT loaded unless listed
    "types": ["node"],

    // strict is already true by default in TS 7; stated explicitly so the intent
    // survives a future default change
    "strict": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // Emit declaration files — these are what carry your JSDoc to any consumer
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
  },
  "include": ["src/**/*", "src"],
  "exclude": ["node_modules", "build"]
}
